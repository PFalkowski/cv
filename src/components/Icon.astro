---
/**
 * The React version pulled Font Awesome off cdnjs for six glyphs. That was a
 * render-blocking third-party stylesheet and a third party watching every visit
 * to the CV. These are inline paths, so the page has no external assets at all.
 */
interface Props {
	name: 'phone' | 'envelope' | 'package' | 'github' | 'stackoverflow' | 'linkedin';
}

const { name } = Astro.props;

const PATHS: Record<Props['name'], string> = {
	phone:
		'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.25 1Z',
	envelope: 'M3 5h18v14H3Zm0 0 9 7 9-7',
	package: 'M12 2 3 7v10l9 5 9-5V7Zm0 0 9 5-9 5-9-5m9 5v10',
	github:
		'M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z',
	stackoverflow: 'M17 21H6v-6M6.8 13.4l9.8 2.1M8.1 8.9l9.2 3.7M10.4 4.9l7.9 5.9M14 2.4l5.9 7.6M18 15v6',
	linkedin:
		'M4.5 3a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3ZM3 8.5h3V21H3Zm6.5 0h3v1.7a3.4 3.4 0 0 1 3-1.7c2.5 0 4 1.6 4 4.7V21h-3v-7c0-1.7-.6-2.6-2-2.6-1.1 0-1.8.8-2 1.6V21h-3Z',
};

const FILLED = new Set<Props['name']>(['phone', 'github', 'linkedin']);
const filled = FILLED.has(name);
---

<svg
	class="icon"
	viewBox="0 0 24 24"
	width="18"
	height="18"
	aria-hidden="true"
	focusable="false"
	fill={filled ? 'currentColor' : 'none'}
	stroke={filled ? 'none' : 'currentColor'}
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<path d={PATHS[name]}></path>
</svg>
