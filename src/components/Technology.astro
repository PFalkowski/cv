---
import Section from './Section.astro';

interface Props {
	t: any;
}

const { t } = Astro.props;
---

<Section id="technology" title={t.sections.technology}>
	<dl class="tech-groups">
		{
			t.technology.groups.map((group: { label: string; value: string }) => (
				<div class="tech-group">
					<dt>{group.label}</dt>
					<dd>{group.value}</dd>
				</div>
			))
		}
	</dl>
</Section>
