---
import Section from './Section.astro';
import { SKILLS, scaleSkills } from '../data/skills.js';

interface Props {
	t: any;
	currentYear: number;
}

const { t, currentYear } = Astro.props;

const rows = scaleSkills(SKILLS, currentYear).map((row) => ({
	name: t.skills[row.id],
	years: row.years,
	width: row.width,
}));
---

<Section id="technicalSkills" title={t.sections.technicalSkills}>
	<ul class="skill-list">
		{
			rows.map((row) => (
				<li class="skill">
					<span class="skill-name">{row.name}</span>
					{/* The bar is a picture of the years, so it carries no information
					    of its own — the years are announced by the text beside it. */}
					<span class="bar" aria-hidden="true">
						<span class="progress" style={`width: ${row.width}%`} />
					</span>
					<span class="skill-years">
						{row.years} {t.skills.yearsSuffix}
					</span>
				</li>
			))
		}
	</ul>
</Section>
